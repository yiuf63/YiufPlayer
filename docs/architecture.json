  "cards": [
    {
      "dot": "cyan",
      "title": "大屏与手柄全驱动 UI",
      "items": [
        "Borealis 框架结合 Yoga Flexbox 布局与 NanoVG 矢量渲染，自适应 1080P/4K、Deck 及开源掌机",
        "统一 Activity 栈管理，完备的手柄、遥控器焦点导航与自绘触控 OSD 控制条"
      ]
    },
    {
      "dot": "emerald",
      "title": "双播放引擎严格隔离",
      "items": [
        "视频引擎 MPVPlayerView 绑定页面生命周期，支持 ASS 字幕与 403 签名过期热重试换链",
        "音频引擎 AudioPlayer 全局单例常驻，macOS App Nap 抑制，支持纯音频后台无损连播"
      ]
    },
    {
      "dot": "rose",
      "title": "QuickJS 轻量脚本沙箱",
      "items": [
        "嵌入式 C99 QuickJS 引擎，16MB 内存硬限制保护，<2MB 轻量占用适配 512MB 低配掌机",
        "宿主安全桥接暴露 host.http/storage/crypto/log，原生驱动 Promise/async 异步执行"
      ]
    },
    {
      "dot": "amber",
      "title": "三合一扩展与安全防护",
      "items": [
        "统一规范整合 MediaStreamProvider 流解析、StorageProvider 网盘挂载与 ScraperProvider 刮削",
        "PluginInstaller 实现标准 ZIP 安装与 Zip Slip 路径穿越防御，原生动态库默认隔离"
      ]
    }
  ]
