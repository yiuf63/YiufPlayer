# Linux 构建环境（Steam Deck / SteamOS 验证用）
#
# 为什么用容器：开发机是 macOS，无法直接产出 Linux 二进制。
#   macOS → Linux 交叉编译需要目标平台的 libmpv / libGL / X11，
#   这些在容器里天然就有，比搭交叉工具链省事。
#
# 构建（amd64，对齐 Steam Deck）：
#   docker build --platform linux/amd64 -f Dockerfile.linux -t muvik-linux .
#   docker run --rm -v "$PWD:/src" -w /src muvik-linux
#
# 注意：首次构建要下载约 300MB 依赖，慢网络下可能 20-40 分钟。
#   分两层缓存：工具链单独一层，装好后重跑只需装业务依赖。

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# ── 第 1 层：基础工具链（很少变化，缓存命中率高）──
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build pkg-config git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ── 第 2 层：业务依赖 ──
RUN apt-get update && apt-get install -y --no-install-recommends \
        libmpv-dev \
        libavutil-dev libavformat-dev libavcodec-dev \
        libcurl4-openssl-dev \
        libgl1-mesa-dev libglu1-mesa-dev \
        libglfw3-dev \
        libfmt-dev \
        libtinyxml2-dev \
        libdbus-1-dev \
        libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
CMD ["bash", "scripts/build-linux.sh"]
