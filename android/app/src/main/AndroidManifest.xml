<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 声明需要 OpenGL ES 3.0：nanoVG 与 mpv 渲染都依赖它。
         wiliwili 同样声明此项，缺少时部分设备会选错 GL 上下文。 -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- 播放本地媒体需要读存储；网络源插件需要 INTERNET -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Android 12 及以下的旧权限名，供 minSdk 24 使用 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        PlatformUtils 会查询 WiFi / 网络状态用于状态栏显示。
        **缺少这些权限会导致应用启动即崩溃**（不是降级，是崩溃）：
          PlatformUtils.isWifiSupported() -> WifiManager.isWifiEnabled()
          -> SecurityException 未被清除 -> JNI FindClass 检测到 pending
          exception -> SIGABRT。
        实测 tombstone:
          "JNI DETECTED ERROR: ... Neither user 10051 nor current process
           has android.permission.ACCESS_WIFI_STATE"
        这类权限是 normal 级别，安装即授予，无需运行时申请。
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 声明是电视/手柄友好应用：会让 Android TV 启动器也列出它 -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.type.television" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:label="DeckPlayer"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:preferMinimalPostProcessing="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:banner="@mipmap/ic_launcher">

        <activity
            android:name=".DeckPlayerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:resizeableActivity="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- LEANBACK_LAUNCHER 让它在 Android TV 启动器里也出现 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- 允许从文件管理器直接打开视频 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
