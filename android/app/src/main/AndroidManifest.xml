<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 声明需要 OpenGL ES 3.0：nanoVG 与 mpv 渲染都依赖它。
         wiliwili 同样声明此项，缺少时部分设备会选错 GL 上下文。 -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- 播放本地媒体需要读存储；网络源插件需要 INTERNET -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!--
        **必须声明** MANAGE_EXTERNAL_STORAGE。这是本项目在 Android 上
        「添加媒体库是空的」「字幕选不了文件」两个问题的根因。

        为什么 READ_MEDIA_VIDEO/AUDIO 不够：
          Android 11 起，READ_MEDIA_* 只授予**通过 MediaStore 查询**
          媒体条目的能力；应用自己用 opendir/readdir 遍历
          /sdcard/Movies 这类目录会被直接拒绝。

          实测（OnePlus Pad / Android 16）：
            READ_MEDIA_VIDEO granted=true
            adb shell run-as org.muvik.android ls /sdcard/Movies
              -> ls: /sdcard/Movies: Permission denied

          而本项目的媒体库是**自己递归扫描目录**（MediaScanner::rebuild），
          没走 MediaStore，因此拿不到任何文件 —— 用户看到的就是空库。
          文件选择器同理，列不出任何视频/字幕文件。

        MANAGE_EXTERNAL_STORAGE 是「所有文件访问」权限：
          · 属于特殊权限，**不能**用 requestPermissions 弹窗申请；
          · 需要在设置页手动开启，代码里用 Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION 跳转；
          · Play 商店对上架应用有此权限的审核，自行分发不受限。

        本项目以 GPL-3.0 自行分发（不上架 Play），因此可以使用。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Android 12 及以下的旧权限名，供 minSdk 24 使用 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        PlatformUtils 会查询 WiFi / 网络状态用于状态栏显示。
        **缺少这些权限会导致应用启动即崩溃**（不是降级，是崩溃）：
          PlatformUtils.isWifiSupported() -> WifiManager.isWifiEnabled()
          -> SecurityException 未被清除 -> JNI FindClass 检测到 pending
          exception -> SIGABRT。
        实测 tombstone:
          "JNI DETECTED ERROR: ... Neither user 10051 nor current process
           has android.permission.ACCESS_WIFI_STATE"
        这类权限是 normal 级别，安装即授予，无需运行时申请。
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 声明是电视/手柄友好应用：会让 Android TV 启动器也列出它 -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.type.television" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:preferMinimalPostProcessing="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:banner="@mipmap/ic_launcher">

        <activity
            android:name=".MuvikActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:resizeableActivity="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- LEANBACK_LAUNCHER 让它在 Android TV 启动器里也出现 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- 允许从文件管理器直接打开视频 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
